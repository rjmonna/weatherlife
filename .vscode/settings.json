{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "C_Cpp.default.includePath": [
      "${workspaceFolder}/src",
      "${workspaceFolder}/include"
    ],
    "C_Cpp.default.defines": [
      "_GNU_SOURCE",
      "WEATHER_LIFE_VERSION=0.1.0"
    ],
    "C_Cpp.default.cStandard": "c99",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.formatting": "Default",
    "C_Cpp.clang_format_style": "{ BasedOnStyle: Linux, IndentWidth: 4, UseTab: Never, ColumnLimit: 100 }",
    "[c]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "ms-vscode.cpptools",
      "editor.wordBasedSuggestions": false,
      "editor.rulers": [80, 100]
    },
    "[python]": {
      "editor.defaultFormatter": "ms-python.python",
      "editor.formatOnSave": true,
      "editor.rulers": [88]
    },
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": true,
    "python.linting.pylintArgs": ["--max-line-length=100"],
    "files.exclude": {
      "build": true,
      "builddir": true,
      "builddir-*": true,
      "**/*.o": true,
      "**/*.a": true,
      "**/*.so": true,
      "**/__pycache__": true,
      "**/*.pyc": true
    },
    "search.exclude": {
      "build": true,
      "builddir": true,
      ".git": true,
      "install": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-vscode.cpptools",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "eamodio.gitlens",
      "ms-vscode.cmake-tools",
      "mesonbuild.mesonbuild",
      "redhat.vscode-yaml",
      "charliermarsh.ruff",
      "llvm-vs-code-extensions.vscode-clangd"
    ]
  },
  "ghidramcp.bridgeScriptPath": "C:\\Users\\rmonn\\bin\\bridge_mcp_ghidra.py",
  "python.analysis.typeCheckingMode": "strict",
  "mesonbuild.configureOnOpen": true,
  "chat.tools.terminal.autoApprove": {
    "/^find /mnt /home/rjmonna -maxdepth 4 -type f \\\\\\( -iname 'weather\\.exe' -o -iname 'usbwr\\.exe' -o -iname 'onlywell\\.dll' \\\\\\) -print 2>/dev/null \\| head -40; printf '\\\\nWine prefix binaries:\\\\n'; find /home/rjmonna/\\.wine -maxdepth 5 -type f \\\\\\( -iname 'weather\\.exe' -o -iname 'usbwr\\.exe' \\\\\\) -print 2>/dev/null \\| head -20$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^id; lsusb -d 1130:0202 2>&1 \\|\\| true; ls -l builddir/weather-life-discover builddir/tests/weather-life-native-tests 2>&1 \\|\\| true; meson test -C builddir --print-errorlogs$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^meson test -C builddir --print-errorlogs$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^git status --short && printf '\\\\nCandidate binaries:\\\\n' && find \\. -type f \\\\\\( -iname '\\*\\.dll' -o -iname '\\*\\.exe' -o -iname '\\*\\.pdb' \\\\\\) -print \\| head -100$/": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    "./tests",
    "-p",
    "test*.py"
  ],
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": true
}
